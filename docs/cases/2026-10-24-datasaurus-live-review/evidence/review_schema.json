{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "claim_id": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "qualified",
              "unsupported",
              "not_tested"
            ]
          },
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "locator"
              ]
            }
          }
        },
        "required": [
          "id",
          "claim_id",
          "status",
          "title",
          "explanation",
          "evidence"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "findings",
    "limitations"
  ]
}